[Unit]
Description=Open Mercato
After=network.target postgres.service
Wants=postgres.service

[Service]
Type=exec
User=open-mercato-builder
Group=open-mercato-builder
WorkingDirectory=/home/open-mercato-builder/workspace
Environment=HOME=/home/open-mercato-builder
Environment=COREPACK_HOME=/usr/local/share/corepack
Environment=PORT=3000
Environment=OM_DEV_INOTIFY_CHECK=0
Environment=OM_DEV_BUNDLER=turbopack
ExecStart=/usr/local/bin/yarn dev --watch=auto-optimized
Restart=always

[Install]
WantedBy=multi-user.target
